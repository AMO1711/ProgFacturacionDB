<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="modelo.view_controllers.ClienteController">
    <tabs>
        <Tab text="Crear Cliente">
            <VBox spacing="15" style="-fx-padding: 20;">
                <Label text="Nuevo Registro de Cliente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" />
                        <ColumnConstraints prefWidth="500" />
                    </columnConstraints>

                    <Label text="NIF:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNif" maxWidth="80" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre Empresa:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" maxWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Dirección:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtDireccion" maxWidth="1000" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Código Postal:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCp" maxWidth="70" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Población:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPoblacion" maxWidth="150" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Provincia:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbProvincia" maxWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Email:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmail" maxWidth="200" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                </GridPane>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button text="Limpiar" onAction="#limpiarCamposCrear" prefWidth="100"/>
                    <Button text="Guardar Cliente" onAction="#guardarCliente" prefWidth="150" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Buscar Cliente">
            <VBox spacing="15" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Buscar por:"/>
                    <ComboBox fx:id="cbCampoBuscar" prefWidth="120"/>
                    <TextField fx:id="txtValorBuscar" promptText="Escribe aquí..." HBox.hgrow="ALWAYS"/>
                    <Button text="🔍 Buscar" onAction="#buscarCliente" prefWidth="100"/>
                </HBox>
                <Separator/>
                <VBox fx:id="areaResultadoBuscar" spacing="10" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-border-color: #ddd;" visible="false">
                    <Label fx:id="lblResNombre" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblResDetalles" wrapText="true"/>
                </VBox>
            </VBox>
        </Tab>

        <Tab text="Listado General">
            <VBox spacing="10" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Ordenar listado por:"/>
                    <ComboBox fx:id="cbOrdenListado" onAction="#actualizarListado" prefWidth="150"/>
                    <Button text="🔄 Refrescar" onAction="#actualizarListado"/>
                </HBox>
                <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colNif" text="NIF" prefWidth="100"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
                        <TableColumn fx:id="colPoblacion" text="Población" prefWidth="150"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Eliminar Registro">
            <VBox spacing="15" style="-fx-padding: 20;">
                <Label text="Búsqueda de seguridad para eliminación" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <ComboBox fx:id="cbCampoEliminar" prefWidth="120"/>
                    <TextField fx:id="txtValorEliminar" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#buscarParaEliminar"/>
                </HBox>
                <VBox fx:id="areaConfirmarEliminar" visible="false" spacing="15" style="-fx-border-color: red; -fx-padding: 20; -fx-background-color: #fff5f5;">
                    <Label text="¿ESTÁ SEGURO DE QUE DESEA ELIMINAR ESTE CLIENTE?" style="-fx-font-weight: bold; -fx-text-fill: red;"/>
                    <Label fx:id="lblDatosEliminar" text="Datos del cliente..."/>
                    <HBox spacing="10">
                        <Button text="No, Cancelar" onAction="#cancelarEliminar"/>
                        <Button text="SÍ, ELIMINAR DEFINITIVAMENTE" onAction="#confirmarEliminar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
    </tabs>
</TabPane>