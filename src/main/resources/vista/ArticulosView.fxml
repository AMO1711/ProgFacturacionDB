<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="modelo.view_controllers.ArticulosController">
    <tabs>
        <Tab text="Crear Artículo">
            <VBox spacing="15" style="-fx-padding: 20;">
                <Label text="Nuevo Registro de Artículo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" />
                        <ColumnConstraints prefWidth="500" />
                    </columnConstraints>

                    <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCodigo" maxWidth="70" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" maxWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtDescripcion" maxWidth="1000" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Precio Venta (€):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPrecioVenta" maxWidth="70" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Stock Actual:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtStockActual" maxWidth="70" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Tipo de IVA:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbIvaPercent" maxWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button text="Limpiar" onAction="#limpiarCamposCrear" prefWidth="100"/>
                    <Button text="Guardar Artículo" onAction="#guardarArticulo" prefWidth="150" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Buscar">
            <VBox spacing="15" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Buscar por:"/>
                    <ComboBox fx:id="cbCampoBuscar" prefWidth="130"/>
                    <TextField fx:id="txtValorBuscar" promptText="Valor..." HBox.hgrow="ALWAYS"/>
                    <Button text="🔍 Buscar" onAction="#buscarArticulo" prefWidth="100"/>
                </HBox>
                <Separator/>
                <VBox fx:id="areaResultadoBuscar" spacing="10" style="-fx-background-color: #f0f7ff; -fx-padding: 15; -fx-border-color: #3498db;" visible="false">
                    <Label fx:id="lblResNombre" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblResDetalles" wrapText="true"/>
                </VBox>
            </VBox>
        </Tab>

        <Tab text="Listado">
            <VBox spacing="10" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Ordenar por:"/>
                    <ComboBox fx:id="cbOrdenListado" onAction="#actualizarListado" prefWidth="150"/>
                    <Button text="🔄 Refrescar" onAction="#actualizarListado"/>
                </HBox>
                <TableView fx:id="tablaArticulos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                        <TableColumn fx:id="colPrecioVenta" text="Precio Venta" prefWidth="100"/>
                        <TableColumn fx:id="colStockActual" text="Stock" prefWidth="100"/>
                        <TableColumn fx:id="colIva" text="IVA" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Eliminar">
            <VBox spacing="15" style="-fx-padding: 20;">
                <Label text="Eliminación de Artículos" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <ComboBox fx:id="cbCampoEliminar" prefWidth="120"/>
                    <TextField fx:id="txtValorEliminar" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#buscarParaEliminar"/>
                </HBox>
                <VBox fx:id="areaConfirmarEliminar" visible="false" spacing="15" style="-fx-border-color: #e74c3c; -fx-padding: 20; -fx-background-color: #fff5f5;">
                    <Label text="CONFIRME ELIMINACIÓN DEL ARTÍCULO" style="-fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                    <Label fx:id="lblDatosEliminar" text="Datos..."/>
                    <HBox spacing="10">
                        <Button text="Cancelar" onAction="#cancelarEliminar"/>
                        <Button text="BORRAR DEFINITIVAMENTE" onAction="#confirmarEliminar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
    </tabs>
</TabPane>